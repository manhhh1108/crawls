# ===== Cache (tai lai duoc, khong commit) =====
# cache HTTP/browser/dich cua shared.fetcher & content/translate.py
.cache/
# anh goc tai tu web hang (ghep lai duoc, da co cache)
content/out/*/src_img/
# anh da ghep logo + file Excel bai viet: sinh lai bang
#   python c_<hang>.py && python build_content_excel.py
# (khong commit de khoi phinh repo khi nhan ra 16 hang ~1.3GB)
content/out/*/images/
data/Noi dung */[0-9][0-9] - *.xlsx
data/Noi dung */[0-9][0-9][0-9] - *.xlsx
# anh thanh pham cua bai dang (SICK ~37MB) - sinh lai bang build_<hang>_excel.py
data/Noi dung */images/
# ban sao giao hang: gop toan bo xlsx + anh cua cac hang da xong (~129MB),
# trung lap voi data/Noi dung <hang>/ o tren
data/File đã crawls/
# anh ban HD do fix_images_hd.py tai ve (nam canh anh goc trong src_img)
*.hd.jpg
*.hd.jpeg
*.hd.png
*.hd.webp

# ===== Ban sao luu truoc khi crawl lai =====
# vd "data/Noi dung SICK (ban cu 2026-10-10)/" ~130MB
data/Noi dung * (ban cu *)/
# file nen ban giao / sao luu o bat ky dau (truoc day chi chan data/*.zip)
*.zip
*.rar
*.7z
# file xlsx sinh ra tu danh muc goc (dung make_sick_input.py tao lai)
data/* (bo ma SP cu the).xlsx

# ===== Python =====
__pycache__/
*.pyc
.venv/
venv/

# ===== Node (du an SICK cu) =====
node_modules/

# ===== Excel/Office =====
# file lock khi dang mo Excel/Word
~$*
*.tmp

# ===== Backup & log =====
*.bak
*.log
log_*.txt
content/logs/
catalog/logs/
# cache dich ~80MB cua du an SICK
sick/translation-cache.json

# ===== He dieu hanh =====
Thumbs.db
desktop.ini
.DS_Store

# ===== Trinh duyet tu dong (Playwright) =====
# profile Chrome dung khi crawl trang chan bot (leuze/ifm) - sinh lai duoc
.playwright/
playwright-user-data/
test-results/

# ===== Editor =====
.vscode/
.idea/
*.code-workspace

# ===== Windows =====
# file 'nul' bi tao ra khi chay '2>nul' trong Git Bash
nul

# ===== API key - KHONG BAO GIO COMMIT =====
.env
.env.*
*.key
