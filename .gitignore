# ===== Cache (tai lai duoc, khong commit) =====
# cache HTTP/browser/dich cua shared.fetcher & content/translate.py
.cache/
# anh goc tai tu web hang (ghep lai duoc, da co cache)
content/out/*/src_img/
# anh da ghep logo + file Excel bai viet: sinh lai bang
#   python c_<hang>.py && python build_content_excel.py
# (khong commit de khoi phinh repo khi nhan ra 16 hang ~1.3GB)
content/out/*/images/
data/Noi dung */[0-9][0-9] - *.xlsx
data/Noi dung */[0-9][0-9][0-9] - *.xlsx

# ===== Python =====
__pycache__/
*.pyc
.venv/
venv/

# ===== Node (du an SICK cu) =====
node_modules/

# ===== Excel/Office =====
# file lock khi dang mo Excel/Word
~$*
*.tmp

# ===== Backup & log =====
*.bak
*.log
log_*.txt
content/logs/
catalog/logs/
# cache dich ~80MB cua du an SICK
sick/translation-cache.json

# ===== He dieu hanh =====
Thumbs.db
desktop.ini
.DS_Store
